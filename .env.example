# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Public project URL and anon key. Both are safe to ship to the browser:
# the anon key is only ever as powerful as your RLS policies allow, and the
# tools table grants it SELECT on published/planned rows and nothing else.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service-role key. Full read/write, bypasses RLS.
# SERVER ONLY. Never add a NEXT_PUBLIC_ prefix. It is imported exclusively by
# src/lib/supabase/admin.ts, which is marked `server-only` so that importing
# it from a client component is a BUILD ERROR rather than a silent leak.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, used for metadataBase, sitemap and robots. Never hardcode
# a hostname in source -- this is the single switch for moving to a custom
# domain later. Falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin allowlist
# ---------------------------------------------------------------------------
# Comma-separated emails permitted to reach /admin. REQUIRED -- an empty or
# missing value authorizes nobody.
#
# A valid Supabase session is NOT sufficient on its own: Supabase accepts public
# signups by default, so without this allowlist any stranger who registers would
# become an admin of a public site. Also disable public signup in the Supabase
# dashboard (Authentication -> Providers -> Email -> "Allow new users to sign up").
ADMIN_EMAILS=you@example.com
