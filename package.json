{
  "name": "ai-tools-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --no-warnings --experimental-strip-types scripts/bootstrap.mts; next start",
    "lint": "eslint",
    "test:ssrf": "node --no-warnings --experimental-strip-types tests/ssrf.test.mts",
    "test:search": "node --no-warnings --experimental-strip-types tests/search.test.mts",
    "test:contrast": "node --no-warnings --experimental-strip-types tests/contrast.test.mts",
    "test": "npm run test:ssrf && npm run test:search && npm run test:contrast && npm run test:i18n && npm run test:secret",
    "migrate": "node --no-warnings --experimental-strip-types scripts/migrate.mts",
    "create-super-admin": "node --no-warnings --experimental-strip-types scripts/create-super-admin.mts",
    "bootstrap": "node --no-warnings --experimental-strip-types scripts/bootstrap.mts",
    "test:i18n": "node --no-warnings --experimental-strip-types tests/i18n.test.mts",
    "test:secret": "node --no-warnings --experimental-strip-types --conditions=react-server tests/secret-box.test.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
